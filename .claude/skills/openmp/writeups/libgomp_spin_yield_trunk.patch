diff --git a/libgomp/config/linux/wait.h b/libgomp/config/linux/wait.h
index f914140..1c58462 100644
--- a/libgomp/config/linux/wait.h
+++ b/libgomp/config/linux/wait.h
@@ -44,10 +44,12 @@
 extern int gomp_futex_wait, gomp_futex_wake;
 
 #include <futex.h>
+#include <sched.h>
 
 static inline int do_spin (int *addr, int val)
 {
   unsigned long long i, count = gomp_spin_count_var;
+  unsigned long long yield = gomp_spin_yield_var, until_yield = yield;
 
   if (__builtin_expect (__atomic_load_n (&gomp_managed_threads,
                                          MEMMODEL_RELAXED)
@@ -57,7 +59,18 @@ static inline int do_spin (int *addr, int val)
     if (__builtin_expect (__atomic_load_n (addr, MEMMODEL_RELAXED) != val, 0))
       return 0;
     else
-      cpu_relax ();
+      {
+	cpu_relax ();
+	/* Let other threads run from time to time: a thread of the team
+	   that blocked (e.g. on a mutex) or a thread of another runtime may
+	   be waiting for a CPU, and would otherwise only get one once the
+	   spinning threads go to sleep.  */
+	if (yield && --until_yield == 0)
+	  {
+	    sched_yield ();
+	    until_yield = yield;
+	  }
+      }
   return 1;
 }
 
